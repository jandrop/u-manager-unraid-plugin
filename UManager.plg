<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
<!ENTITY name "UManager">
<!ENTITY displayName "U-Manager Push Notifications">
<!ENTITY author "jandrop">
<!ENTITY version "2026.09.17">
<!ENTITY launch "Settings/Notifications">
<!ENTITY plugdir "/usr/local/emhttp/plugins/&name;">
<!ENTITY github "jandrop/u-manager-unraid-plugin">
<!ENTITY pluginURL "https://github.com/&github;/releases/latest/download/&name;.plg">
<!ENTITY icon "https://raw.githubusercontent.com/&github;/&version;/plugins/dynamix/icons/umanager.png">
<!ENTITY xmlMD5 "c45f07be8ce5a4358eb46217ce4c254a">
<!ENTITY iconMD5 "dbb5da55e4bfc20fa23a027f6cbee41b">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" icon="&name;.png" min="6.11.0" support="https://github.com/&github;/issues">

<CHANGES>
<![CDATA[
###2026.09.17
- Stop re-downloading the plugin's agent XML and icon on every boot.
  Each file is now fetched once per version and kept on /boot, so a
  boot with no internet access still finishes the install instead of
  leaving the agent missing.

###2026.06.03.2
- Fix the plugin icon and description not showing in the Unraid
  Plugins page after a fresh install on top of 2026.06.03.1. The
  previous release tried to set a human row title at the wrong place
  in the manifest, which broke the on-disk path the Plugins page
  uses to load the icon and the description from. The human name
  ("U-Manager Push Notifications") now comes from the README header
  instead.

###2026.06.03.1
- The Unraid Plugins page now shows the plugin as "U-Manager Push
  Notifications" so it's clearer what the entry does. No behaviour
  changes — same notification agent, same install paths.

###2026.05.31.4
- Fix the plugin icon on the Unraid Plugins page.

###2026.05.18.1
- Show plugin description in the Plugins page (Unraid reads it from
  the plugin's README.md, not from the .plg comment).

###2026.05.18
- Show plugin icon and Support link (GitHub Issues) in the Plugins page.

###2026.05.07
- Initial Release: Push notification agent for U-Manager iOS/Android app.
]]>
</CHANGES>

<!-- Plugin description shown in the Plugins page. Unraid renders the
     contents of /usr/local/emhttp/plugins/<name>/README.md as Markdown. -->
<FILE Name="&plugdir;/README.md">
<INLINE>
**&displayName;**

Push notification agent for the U-Manager mobile app. Forwards Unraid Dynamix notifications to your device.
</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
mkdir -p /boot/config/plugins/&name;
echo "Installing &displayName;..."
</INLINE>
</FILE>

<!-- Unraid replays this install on every boot and skips a declared file
     whose target already exists with a matching hash, so both land on
     /boot and a boot with no internet still works. Both are fetched from
     the release tag, and the release workflow fails if the MD5 entities
     above do not match the tagged files. -->
<FILE Name="/boot/config/plugins/&name;/UManager-&version;.xml">
<URL>https://raw.githubusercontent.com/&github;/&version;/plugins/dynamix/agents/UManager.xml</URL>
<MD5>&xmlMD5;</MD5>
</FILE>

<FILE Name="/boot/config/plugins/&name;/umanager-&version;.png">
<URL>&icon;</URL>
<MD5>&iconMD5;</MD5>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
# rootfs is RAM and empty again after every boot. Unraid loads the
# Plugins-page icon from &name;.png under &plugdir;.
B=/boot/config/plugins/&name;
cp $B/UManager-&version;.xml /usr/local/emhttp/plugins/dynamix/agents/UManager.xml
cp $B/umanager-&version;.png /usr/local/emhttp/plugins/dynamix/icons/umanager.png
cp $B/umanager-&version;.png &plugdir;/&name;.png
rm -f $(ls $B/UManager-*.xml 2>/dev/null | grep -v '&version;')
rm -f $(ls $B/umanager-*.png 2>/dev/null | grep -v '&version;')
chmod +x /usr/local/emhttp/plugins/dynamix/agents/UManager.xml
echo ""
echo "----------------------------------------------------"
echo " &displayName; has been successfully installed."
echo " Version: &version;"
echo " Go to Settings -> Notifications -> Agents to configure."
echo "----------------------------------------------------"
echo ""
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
rm -rf /usr/local/emhttp/plugins/dynamix/agents/UManager.xml
rm -rf /usr/local/emhttp/plugins/dynamix/icons/umanager.png
rm -rf &plugdir;
rm -rf /boot/config/plugins/&name;
echo ""
echo "----------------------------------------------------"
echo " &displayName; has been removed."
echo "----------------------------------------------------"
echo ""
</INLINE>
</FILE>

</PLUGIN>
